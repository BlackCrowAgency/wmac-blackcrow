<Window x:Class="WMac.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Ajustes de WMac" Width="580" Height="740" MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="Transparent" Foreground="{DynamicResource DialogText}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource DialogTint}" TextElement.Foreground="{DynamicResource DialogText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="24,14,0,10">
            <Image Source="{StaticResource AppLogo}" Width="28" Height="28"/>
            <TextBlock Text="Ajustes de WMac" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,22">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="ESCRITORIO"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox x:Name="DesktopSwitch" Style="{StaticResource Switch}" Content="Escritorio WMac activo"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,64,4" Foreground="{DynamicResource DialogSubText}"
                                   Text="Se muestra detrás de tus ventanas. Al desactivarlo, tu escritorio vuelve a estar como lo dejaste."/>
                        <Button x:Name="PreviewButton" Style="{StaticResource PillButton}" Content="Vista previa en ventana"
                                HorizontalAlignment="Left" Margin="0,10,0,8"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="ICONOS"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,7">
                            <TextBlock Text="Tamaño" FontSize="13.5" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" CornerRadius="9" Padding="3" Background="{DynamicResource ControlBackground}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SizeSmall" GroupName="size" Style="{StaticResource Segment}" Content="Pequeños"/>
                                    <RadioButton x:Name="SizeMedium" GroupName="size" Style="{StaticResource Segment}" Content="Medianos"/>
                                    <RadioButton x:Name="SizeLarge" GroupName="size" Style="{StaticResource Segment}" Content="Grandes"/>
                                    <RadioButton x:Name="SizeXLarge" GroupName="size" Style="{StaticResource Segment}" Content="Extra"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <CheckBox x:Name="IconsSwitch" Style="{StaticResource Switch}" Content="Mostrar iconos del escritorio"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,64,4" Foreground="{DynamicResource DialogSubText}"
                                   Text="Los grupos son solo visuales: tus archivos se quedan donde están."/>
                        <Button x:Name="OrganizeButton" Style="{StaticResource PillButton}" Content="Organizar automáticamente"
                                HorizontalAlignment="Left" Margin="0,8,0,8"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="WIDGETS"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox x:Name="ClockSwitch" Style="{StaticResource Switch}" Content="Reloj analógico"/>
                        <CheckBox x:Name="SecondsSwitch" Style="{StaticResource Switch}" Content="Segundero" Margin="18,7,0,7"/>
                        <CheckBox x:Name="DateSwitch" Style="{StaticResource Switch}" Content="Fecha en el reloj" Margin="18,7,0,7"/>
                        <CheckBox x:Name="MusicSwitch" Style="{StaticResource Switch}" Content="Música"/>
                        <CheckBox x:Name="WeatherSwitch" Style="{StaticResource Switch}" Content="Clima"/>
                        <CheckBox x:Name="CalendarSwitch" Style="{StaticResource Switch}" Content="Calendario"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="CLIMA"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Margin="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CityBox" Style="{StaticResource GlassTextBox}"/>
                            <Button x:Name="CityButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Buscar" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="CityStatus" FontSize="12.5" Margin="2,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogSubText}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Unidades" FontSize="13.5" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" CornerRadius="9" Padding="3" Background="{DynamicResource ControlBackground}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="UnitC" GroupName="unit" Style="{StaticResource Segment}" Content="°C"/>
                                    <RadioButton x:Name="UnitF" GroupName="unit" Style="{StaticResource Segment}" Content="°F"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CityClear" Style="{StaticResource LinkButton}" Content="Quitar ciudad"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="INICIO"/>
                <Border Style="{StaticResource SettingsCard}">
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Content="Iniciar WMac al iniciar sesión en Windows"/>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="RESPALDO Y PROTECCIÓN"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox x:Name="ProtectSwitch" Style="{StaticResource Switch}" Content="Proteger los archivos del escritorio (recomendado)"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,64,4" Foreground="{DynamicResource DialogSubText}"
                                   Text="WMac solo abre y copia. Nunca elimina, renombra ni mueve tus archivos."/>
                        <TextBlock x:Name="BackupStatus" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <WrapPanel Margin="0,10,0,8">
                            <Button x:Name="CheckButton" Style="{StaticResource PillButton}" Content="Comprobar mi escritorio" Margin="0,0,10,6"/>
                            <Button x:Name="BackupButton" Style="{StaticResource PillButton}" Content="Guardar respaldo ahora" Margin="0,0,10,6"/>
                            <Button x:Name="BackupFolderButton" Style="{StaticResource LinkButton}" Content="Abrir carpeta de respaldos" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="RESTAURACIÓN"/>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel Margin="0,8">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource DialogSubText}"
                                   Text="Cierra WMac y comprueba que cada icono siga en su sitio. También está en el menú Inicio, por si WMac no responde."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <Button x:Name="RestoreButton" Style="{StaticResource PillButton}" Content="Restaurar escritorio original"/>
                            <Button x:Name="ExitButton" Style="{StaticResource PillButton}" Content="Salir de WMac" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Footer" FontSize="11.5" Margin="4,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DialogSubText}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
