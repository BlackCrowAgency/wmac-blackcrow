<Window x:Class="WMac.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="WMac" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        FontFamily="Segoe UI" Background="Transparent" Foreground="{DynamicResource DialogText}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource DialogTint}" TextElement.Foreground="{DynamicResource DialogText}">
        <StackPanel Margin="30,40,30,26">
            <Image Source="{StaticResource AppLogo}" Width="52" Height="52" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource DialogSubText}"/>
            <TextBlock x:Name="CountdownText" FontSize="12.5" Margin="0,14,0,0" Foreground="{DynamicResource DialogSubText}" Visibility="Collapsed"/>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"/>
        </StackPanel>
    </Grid>
</Window>
