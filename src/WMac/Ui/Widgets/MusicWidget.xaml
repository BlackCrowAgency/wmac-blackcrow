<UserControl x:Class="WMac.MusicWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WMac"
             x:ClassModifier="internal"
             Width="300" Height="344" FontFamily="Segoe UI">
    <local:GlassCard x:Name="Card" CornerRadius="30" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="178"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Border x:Name="ArtPlaceholder" CornerRadius="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#995E5CE6" Offset="0"/>
                            <GradientStop Color="#99BF5AF2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M 20,0 L 20,32 A 7,6 0 1 1 15,26 L 15,7 L 40,2 L 40,28 A 7,6 0 1 1 35,22 L 35,8 L 20,11 Z"
                          Fill="#CCFFFFFF" Width="54" Height="54" Stretch="Uniform"/>
                </Border>
                <Border x:Name="Art" CornerRadius="18" Visibility="Collapsed"/>
                <Border x:Name="SourceBadge" CornerRadius="9" Padding="8,3" Background="#73000000" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <TextBlock x:Name="SourceText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="2,12,2,0">
                <TextBlock x:Name="TitleText" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource GlassText}"/>
                <TextBlock x:Name="ArtistText" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Foreground="{DynamicResource GlassSubText}"/>
            </StackPanel>

            <Grid x:Name="ProgressRow" Grid.Row="2" Margin="2,12,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Track" CornerRadius="2" Background="{DynamicResource GlassDim}"/>
                <Border x:Name="Fill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{DynamicResource GlassText}"/>
                <TextBlock x:Name="ElapsedText" Grid.Row="1" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource GlassSubText}"/>
                <TextBlock x:Name="RemainText" Grid.Row="1" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource GlassSubText}"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource MediaButton}" ToolTip="Anterior">
                    <Path Data="M 22,0 L 22,16 L 11,8 Z M 11,0 L 11,16 L 0,8 Z" Width="22" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource GlassText}"/>
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource MediaButton}" Margin="26,0" ToolTip="Reproducir / pausar">
                    <Path x:Name="PlayIcon" Data="M 0,0 L 0,20 L 17,10 Z" Width="22" Height="24" Stretch="Uniform"
                          Fill="{DynamicResource GlassText}"/>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource MediaButton}" ToolTip="Siguiente">
                    <Path Data="M 0,0 L 0,16 L 11,8 Z M 11,0 L 11,16 L 22,8 Z" Width="22" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource GlassText}"/>
                </Button>
            </StackPanel>
        </Grid>
    </local:GlassCard>
</UserControl>
